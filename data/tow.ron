// TOW's worlds, from `WorldLevelNames` in `TOW/globals.bb`. They play as
// RTWP's world pack 3 (worlds 30 to 39, levels 300 to 399), the kids pack
// RTWP never reaches, so their scores keep to those slots of the player
// file. `names` are `WorldName$` in English, German and French. The
// playground is TOW's world 40 (`PlayGroundLevel = 400`, the same in
// RTWP), and `theend.lev` (level 410) is the ending's stage. An empty file
// name is an empty slot; trailing empty slots are left out.
(
    worlds: [
        (names: ["TRAINING GROUNDS", "UEBUNGSGELAENDE", "L'ENTRAINEMENT"], levels: ["tut1.lev", "tut2.lev", "tut3.lev", "tut4.lev", "tut5.lev"]), // 30
        (names: ["THE WATER PALACE", "DER WASSERPALAST", "LE PALAIS D'EAU"], levels: ["castleb.lev", "fishy.lev", "coily.lev", "friends.lev", "telebroken.lev", "airlock.lev", "loofrescue.lev", "bombintro.lev"]), // 31
        (names: ["WINTER IN WONDERLAND", "WINTER IM WONDERLAND", "L'HIVER A WONDERLAND"], levels: ["iceintro.lev", "centreice.lev", "fishbarrel.lev", "heretheycome.lev", "collide.lev", "soclose.lev", "ricochet.lev", "spiral.lev", "steelintro.lev", "fireice.lev"]), // 32
