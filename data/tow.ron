        (names: ["TOP OF THE WORLD", "DACH DER WELT", "LE SOMMET DU MONDE"], levels: ["robotintro.lev", "slip.lev", "towerhop.lev", "teamwork.lev", "robowater.lev"]), // 34
        (names: ["DESERT CITIES", "WUESTENSTAEDTE", "LES VILLES DU DESERT"], levels: ["temple.lev", "longway.lev", "separate.lev", "jones.lev", "river.lev", "greedy.lev", "sort.lev", "whoops.lev", "moats.lev", "prisoners.lev"]), // 35
        (names: ["SPACED OUT", "IM WELTRAUM", "PERDU DANS L'ESPACE"], levels: ["tictac.lev", "robotcity.lev", "tight.lev", "pacman.lev", "timerintro.lev", "timegates.lev", "pushshove.lev", "scouge.lev"]), // 36
        (names: ["MIXED UP STINKY & LOOF", "STINKY & LOOF", "STINKY & LOOF CONFONDUS"], levels: ["network.lev", "dizzy.lev", "tensecs.lev", "slipslide.lev", "boxfactory.lev"]), // 37
        (names: ["HEART OF THE VOLCANO", "IM HERZEN DES VULKANS", "AU COEUR DU VOLCAN"], levels: ["cavein.lev", "firewall.lev", "bombsalot.lev", "armoury.lev", "bombwalk.lev", "onecoin.lev", "readyrun.lev", "shortsweet.lev", "stuck.lev", "teletrap.lev"]), // 38
